{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cybersecurity.cybersecurity-ticketing",
  "main": "src/index.js",
  "compatibility_date": "2025-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "incident-db",
      "database_id": "9e105d89-de1a-49e1-9bf9-4a89501760d5"
    }
  ]
}
